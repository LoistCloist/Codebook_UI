# Postgres (docker compose maps the container to host port 5433)
DATABASE_URL="postgresql://codebook:codebook@localhost:5433/codebook?schema=public"
# Production only (see docs/deploy-vercel.md); leave blank locally.
#   DIRECT_URL: direct/session connection used by `prisma migrate` (falls back to DATABASE_URL)
#   DATABASE_POOL_MAX: connections per server instance (default 3 in production, 10 otherwise)
#   DATABASE_SSL_CA: the database's root CA certificate (PEM); if set, don't put sslmode in DATABASE_URL
DIRECT_URL=""
DATABASE_POOL_MAX=""
DATABASE_SSL_CA=""
# Used only by `npm run test:integration`; must differ from DATABASE_URL
TEST_DATABASE_URL="postgresql://codebook:codebook@localhost:5433/codebook_test?schema=public"

# Google OAuth (Google Cloud console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Auth.js. Generate secrets with: openssl rand -hex 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# HMAC key for participant_hash. Never change it after data collection starts.
PARTICIPANT_HASH_SECRET=""

# Comma-separated Google account emails allowed into /admin
ADMIN_EMAILS=""

# Optional shared rate-limit store (Upstash Redis). Set both on multi-instance/serverless hosts;
# leave blank locally to use the in-memory limiter.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
